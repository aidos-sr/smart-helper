OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_UTILITY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_UTILITY_FALLBACK_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_FAST_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FAST_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FAST_LAST_RESORT_MODEL=openrouter/free
OPENROUTER_DEEP_MODEL=google/gemini-3.8-flash
OPENROUTER_DEEP_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_DEEP_LAST_RESORT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_STRUCTURED_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_STRUCTURED_FALLBACK_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_STRUCTURED_LAST_RESORT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
PUBLIC_SITE_URL=https://your-project.vercel.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me
AI_MINUTE_LIMIT=10
AI_DAILY_LIMIT=50

# Apply 202611250001_audit_hardening.sql before deploying the updated API.
# Set the global allowance to the actual shared provider account allowance.
AI_GLOBAL_ATTEMPTS_PER_DAY=2000
AI_PROJECT_CONCURRENCY=10
# Paid mode is disabled unless both enabled and the authenticated UUID is listed.
AI_PAID_ENABLED=false
AI_PAID_USER_IDS=
# Conservative reservation limits; also configure a hard spending limit at OpenRouter.
AI_USER_DAILY_BUDGET_USD=0.5
AI_GLOBAL_DAILY_BUDGET_USD=5
AI_MAX_PRICE_PER_MILLION=1
# Set true only after confirming endpoint compatibility and account privacy settings.
AI_REQUIRE_ZDR=false
AI_ALLOWED_PROVIDERS=
